{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "gh *": "allow",
      "pnpm *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "cargo *": "allow",
      "rustc *": "allow",
      "rustup *": "allow",
      "node *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "cut *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "pwd *": "allow",
      "mkdir *": "allow",
      "cp *": "ask",
      "mv *": "ask",
      "rm *": "deny",
      "sudo *": "deny",
      "brew *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "yum *": "deny",
      "dnf *": "deny",
      "pacman *": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask"
    }
  }
}
